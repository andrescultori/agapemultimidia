# Vercel project environment variables (Settings > Environment Variables). Never commit real values.
DATABASE_URL=              # set automatically by the Neon integration (Vercel Marketplace)
SESSION_SECRET=            # 32+ random chars, e.g. `openssl rand -base64 32`
ADMIN_EMAILS=              # comma-separated allow list: fabio@example.com,andre@example.com
RESEND_API_KEY=            # Resend API key (sending access only)
RESEND_FROM=Agape Multimidia <no-reply@agapemultimidia.com.br>
BLOB_READ_WRITE_TOKEN=     # set automatically when a Vercel Blob store is connected
