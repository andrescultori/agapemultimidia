# Environment variables. On Vercel: Settings > Environment Variables. On Cloudflare: Settings > Variables and Secrets (type Secret).
# Never commit real values.
DATABASE_URL=              # Vercel/Node only: Supabase > Project Settings > Database > Connection string > Transaction pooler. On Cloudflare the database is reached through the Hyperdrive binding instead (see ADMIN.md).
SUPABASE_URL=              # Supabase > Project Settings > API > Project URL (https://xxxx.supabase.co)
SUPABASE_SERVICE_KEY=      # Supabase > Project Settings > API Keys > service_role / secret (server only)
SUPABASE_BUCKET=site-images  # optional; public bucket for the hero image
SESSION_SECRET=            # 32+ random chars: `openssl rand -base64 32`
ADMIN_EMAILS=              # comma-separated allow list: fabio@example.com,andre@example.com
RESEND_API_KEY=            # Resend > API Keys > Sending access
RESEND_FROM=Agape Multimidia <no-reply@agapemultimidia.com.br>   # for tests: onboarding@resend.dev (delivers only to your Resend account email)
